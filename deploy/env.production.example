# ═══════════════════════════════════════════════════════════════════════════
# iphoneha.com — production environment
# Lives at /home/iphoneha/app/.env  (chmod 600, owner iphoneha)
#
# Every value marked «CHANGE ME» must be replaced before the first start.
# Generate secrets with:  openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ─── Public URLs ───────────────────────────────────────────────────────────
WEB_URL=https://iphoneha.com
NEXT_PUBLIC_SITE_URL=https://iphoneha.com
API_INTERNAL_URL=http://127.0.0.1:4000
MEDIA_ORIGIN=http://127.0.0.1:4000/api/media
REVALIDATE_SECRET=CHANGE_ME_revalidate_secret

# ─── Ports & binding ───────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
# the reverse proxy is the only thing allowed to reach these
API_BIND=127.0.0.1

# ─── Data services (the two containers from docker-compose.data.yml) ───────
POSTGRES_USER=iphoneha
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=iphoneha
DATABASE_URL=postgresql://iphoneha:CHANGE_ME_db_password@127.0.0.1:55432/iphoneha?schema=public
# the same password twice: the container is started with it, the API signs in with it
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:56379/0

# ─── Sessions & CSRF ───────────────────────────────────────────────────────
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
CORS_ORIGINS=https://iphoneha.com,https://www.iphoneha.com

# ─── OTP ───────────────────────────────────────────────────────────────────
OTP_SECRET=CHANGE_ME_otp_secret_at_least_32_chars
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20
OTP_MAX_VERIFY_PER_15MIN=10
# MUST stay false in production — it would expose OTP codes over HTTP
DEV_EXPOSE_OTP=false

# ─── SMS ───────────────────────────────────────────────────────────────────
# console      → codes only in the log (nobody can sign in but you)
# melipayamak  → real SMS on the shared service line (set by deploy/go-live.sh)
# kavenegar    → real SMS through Kavenegar
SMS_DRIVER=console
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
# bodyId of each approved pattern; only the login one is required
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_ORDER_PAID_BODY_ID=
MELIPAYAMAK_ORDER_SHIPPED_BODY_ID=
# staff alerts — set by deploy/alerts.sh: two more patterns, and/or a Telegram or Bale bot
MELIPAYAMAK_ALERT_REQUEST_BODY_ID=
MELIPAYAMAK_ALERT_ORDER_BODY_ID=
# instalment reminders to customers of the store's own cheque/safte plan (also deploy/alerts.sh)
MELIPAYAMAK_INSTALLMENT_REMINDER_BODY_ID=
# more customer messages (deploy/sms.sh), each optional
MELIPAYAMAK_ORDER_CONFIRMED_BODY_ID=
MELIPAYAMAK_CONTRACT_ISSUED_BODY_ID=
MELIPAYAMAK_INSTALLMENT_PAID_BODY_ID=
MELIPAYAMAK_INSTALLMENT_OVERDUE_BODY_ID=
# ALERT_BOT_SERVICE=telegram        # or bale
# ALERT_BOT_TOKEN=                  # typed in alerts.sh only, never shared
# ALERT_BOT_CHAT_ID=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=iphoneha-otp

# ─── Commerce ──────────────────────────────────────────────────────────────
RESERVATION_TTL_MINUTES=15
MAX_QTY_PER_ITEM=5

# ─── Storage (product images) ──────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/home/iphoneha/app/storage

# ─── Payments ──────────────────────────────────────────────────────────────
# `mock` simulates a gateway: the payer can approve without paying. In
# production a mock-backed method is therefore never offered, shown or
# accepted — only methods with a real driver reach customers.
# deploy/go-live.sh switches ONLINE to zarinpal with your merchant id.
PAYMENT_ONLINE_DRIVER=mock
ZARINPAL_MERCHANT_ID=
# never true in production: a sandbox payment marks the order paid without money
ZARINPAL_SANDBOX=false
# Installment services. SnapPay, Tara, DigiPay, Bajet and AzkiVam are connected
# by deploy/installments.sh, which asks for the keys and writes these lines:
#   live     the service itself — offered to customers
#   sandbox  the service's test environment — offered only to the store's
#            staff (a customer account with an admin's mobile); no money moves
#   mock     not connected — never offered in production
PAYMENT_SNAPPAY_DRIVER=mock
# SNAPPAY_CLIENT_ID=
# SNAPPAY_CLIENT_SECRET=
# SNAPPAY_USERNAME=
# SNAPPAY_PASSWORD=
# SNAPPAY_COMMISSION_TYPE=100       # the commission code of your SnapPay contract
PAYMENT_TARA_DRIVER=mock
# TARA_USERNAME=                    # the Tara merchant panel sign-in
# TARA_PASSWORD=
# TARA_SERVICE_ID=                  # the shop's «gateway code» (کد درگاه)
# TARA_GROUP_CODE=                  # the merchandise group of phones; installment-check.cjs tara lists them
PAYMENT_DIGIPAY_DRIVER=mock
# DIGIPAY_CLIENT_ID=
# DIGIPAY_CLIENT_SECRET=
# DIGIPAY_USERNAME=
# DIGIPAY_PASSWORD=
# Nasiba publishes no merchant API: connected once its documentation arrives
PAYMENT_NESIBA_DRIVER=mock
PAYMENT_BOJET_DRIVER=mock
# BAJET_USERNAME=                   # Bajet (باجت, Bank Tejarat) JETPAY credentials
# BAJET_PASSWORD=
# BAJET_TERMINAL_ID=
# BAJET_PRODUCT_TYPE=               # the basket item type Bajet assigned to phones, if they ask for a basket
PAYMENT_AZKIVAM_DRIVER=mock
# AZKIVAM_MERCHANT_ID=
# AZKIVAM_API_KEY=                  # 64 hex characters
# Only when a service gives you another address (a `live` switch never takes a
# test address): SNAPPAY_BASE_URL, TARA_BASE_URL, DIGIPAY_BASE_URL,
# BAJET_BASE_URL, AZKIVAM_BASE_URL. Tara and Bajet publish no test environment,
# so their `sandbox` needs the test address the service gave you here.
# DigiPay fine-tuning, normally unset: DIGIPAY_TICKET_TYPE (11),
# DIGIPAY_VERIFY_STYLE (body or path), DIGIPAY_SELLER_ID, DIGIPAY_SUPPLIER_ID.
PAYMENT_DISABLED_METHODS=

# ─── Seed (first run only) ─────────────────────────────────────────────────
# empty in production: the owner's admin account is created by deploy/go-live.sh
SEED_ADMIN_PHONE=
SEED_ADMIN_NAME="مدیر فروشگاه"
