{
  "name": "@iphoneha/api",
  "version": "0.1.0",
  "private": true,
  "description": "iPhoneHa REST API (NestJS)",
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:seed": "tsx prisma/seed.ts",
    "catalog:sync": "tsx prisma/catalog-sync.ts",
    "content:sync": "tsx prisma/content-sync.ts",
    "prisma:studio": "prisma studio",
    "otp:reset": "tsx scripts/reset-otp.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@iphoneha/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.2.5",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.4",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
