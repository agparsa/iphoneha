{
  "name": "@iphoneha/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests (Playwright) for the iPhoneHa storefront and admin panel",
  "scripts": {
    "lint": "eslint tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "covers": "node scripts/render-covers.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.20.4",
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.70.0",
    "typescript": "5.9.3"
  }
}
